# Development: your computer's LAN IP (not localhost — a phone can't reach your
# computer's localhost). Windows: ipconfig → IPv4 Address. Mac: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
# Website address — used for Privacy Policy / Terms links and password reset
EXPO_PUBLIC_WEB_URL=http://192.168.1.100:5173

# Release builds MUST use https:// (set these in eas.json for preview/production).
# Demo-only simulated Aadhaar check. Keep false.
EXPO_PUBLIC_AADHAAR_SIMULATION=false
