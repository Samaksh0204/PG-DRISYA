{
  "expo": {
    "name": "PG Drisya",
    "slug": "pg-drisya",
    "scheme": "pgdrisya",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#14B8A6",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#102A43"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drisya.pg",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#102A43"
      },
      "package": "com.drisya.pg",
      "versionCode": 1,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "PG Drisya needs access to your photos so you can add pictures of your property or profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-build-properties",
      "expo-status-bar",
      "expo-font",
      "expo-asset"
    ]
  }
}
