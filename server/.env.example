PORT=5000
NODE_ENV=development

# ── Required ────────────────────────────────────────────────────────────
# MongoDB connection string (MongoDB Atlas → Connect → Drivers)
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/pgdrisya?retryWrites=true&w=majority

# JWT secret (32+ chars in production). Generate: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Public URL of the WEBSITE (used in password-reset / verification email links).
# REQUIRED in production, e.g. https://pgdrisya.com
APP_URL=http://localhost:5173

# Comma-separated allowed browser origins (no trailing slash).
# REQUIRED in production unless CLIENT_DIST is used (same-origin).
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# ── Email (password reset, verification, booking emails) ───────────────
# Email: set EITHER BREVO_API_KEY (HTTPS API; needed on Render's free plan, which blocks
# outgoing SMTP) OR the SMTP_* settings. MAIL_FROM must be a sender verified with your provider.
BREVO_API_KEY=
# Any SMTP provider works (Brevo, SendGrid, Amazon SES, Zoho, Gmail app password).
# Without SMTP, emails are printed to the console in development and dropped in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PG Drisya <no-reply@yourdomain.com>

# ── Photo uploads ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Feature flags ───────────────────────────────────────────────────────
# New listings wait for admin approval. Set to false to publish instantly.
LISTING_MODERATION=true

# Old simulated Aadhaar check — development demos only. The server ignores this
# when NODE_ENV=production. Real verification uses the IDV_* settings below.
AADHAAR_SIMULATION=false
# Only needed if AADHAAR_SIMULATION=true. Generate: openssl rand -hex 32
AADHAAR_PEPPER=

# ── Identity (Aadhaar) verification via an authorised provider ──────────
# Leave IDV_PROVIDER empty until you have a contract with an authorised provider
# (e.g. DigiLocker through a licensed partner, or a licensed KYC provider). The app
# then shows "Verification unavailable" — it never pretends to verify anyone.
#   http = real provider (adapt server/src/services/identityProvider.js to its API)
#   mock = development/testing only; refused when NODE_ENV=production
IDV_PROVIDER=
# Provider API base URL (must be https) and API key — server only, never in the apps.
IDV_API_BASE_URL=
IDV_API_KEY=
# Shared secret the provider uses to sign webhooks sent to POST /api/identity/webhook.
IDV_WEBHOOK_SECRET=
# Where the provider sends people afterwards (defaults to APP_URL/#/profile/edit?tab=identity).
IDV_RETURN_URL=

# Key used to hash IP addresses in the security audit log (defaults to JWT_SECRET).
AUDIT_IP_PEPPER=

# ── Push notifications & analytics ──────────────────────────────────────
# Phone pushes go through Expo's push service; no key is needed by default.
# Only set this if you turn on "enhanced push security" in your Expo account.
EXPO_ACCESS_TOKEN=
# Set to true to stop sending phone pushes (e.g. on a staging server).
PUSH_DISABLED=false
# Key used to anonymise user ids in usage analytics (defaults to JWT_SECRET).
ANALYTICS_SALT=

# ── Optional ────────────────────────────────────────────────────────────
# Serve the built website from this server (single-service deploy):
# CLIENT_DIST=../client/dist
# Number of proxies in front of the app (for correct client IPs in rate limiting)
# TRUST_PROXY_HOPS=1
# Fixes "querySrv ECONNREFUSED" when connecting to Atlas (common on Windows).
# The server already retries with these automatically; set it to skip the retry.
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Seeding wipes data; blocked in production unless this is "true"
# ALLOW_SEED=true
